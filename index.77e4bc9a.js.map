document.addEventListener("click", function(e) {
    // write code here
    var container = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var rect = container.getBoundingClientRect();
    var xInContainer = e.clientX - rect.left;
    var yInContainer = e.clientY - rect.top;
    var spiderRect = spider.getBoundingClientRect();
    var targetX = xInContainer - spiderRect.width / 2;
    var targetY = yInContainer - spiderRect.height / 2;
    var minX = 0;
    var maxX = rect.width - spiderRect.width;
    var minY = 0;
    var maxY = rect.height - spiderRect.height;
    targetX = Math.max(minX, Math.min(targetX, maxX));
